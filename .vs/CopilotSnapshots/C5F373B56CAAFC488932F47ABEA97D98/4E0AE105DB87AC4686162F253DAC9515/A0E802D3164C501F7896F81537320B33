using System.Globalization;
using System.Numerics;
using System.Security.Cryptography;
using System.Text.Json.Serialization;

var builder = WebApplication.CreateBuilder(args);
var app = builder.Build();

var readings = new List<Telemetry>();

app.MapGet("/", () => Results.Ok(new { message = "Server FrigoTrak attivo" }));

app.MapPost("/handshake", (HandshakeRequest? request) =>
{
    if (request is null || string.IsNullOrWhiteSpace(request.p) ||
        string.IsNullOrWhiteSpace(request.g) || string.IsNullOrWhiteSpace(request.A))
    {
        return Results.BadRequest(new ErrorResponse("La richiesta handshake non è valida", "body"));
    }

    try
    {
        var p = HexToBigInteger(request.p);
        var g = HexToBigInteger(request.g);
        var publicKey = HexToBigInteger(request.A);

        if (p <= 2 || g <= 1 || publicKey <= 0 || publicKey >= p)
        {
            return Results.BadRequest(new ErrorResponse("I parametri handshake non sono validi", "p/g/A"));
        }

        var privateKey = RandomNumberGenerator.GetInt32(2, 100000);
        var serverPublicKey = BigInteger.ModPow(g, privateKey, p);

        return Results.Ok(new
        {
            B = serverPublicKey.ToString("X"),
            message = "Handshake completato"
        });
    }
    catch (FormatException)
    {
        return Results.BadRequest(new ErrorResponse("p, g e A devono essere numeri esadecimali", "p/g/A"));
    }
});

app.MapPost("/telemetry", (Telemetry? telemetry) =>
{
    var error = ValidateTelemetry(telemetry);
    if (error is not null)
    {
        return Results.BadRequest(error);
    }

    readings.Add(telemetry!);
    return Results.Created("/readings", telemetry);
});

app.MapPost("/readings", (ReadingsRequest? request) =>
{
    if (request is null || string.IsNullOrWhiteSpace(request.sensor_id))
    {
        return Results.BadRequest(new ErrorResponse("sensor_id è obbligatorio", "sensor_id"));
    }

    return Results.Ok(CreateReadingsResponse(request.sensor_id, request.from, request.to));
});

app.MapGet("/readings", (string? sensor_id, DateTimeOffset? from, DateTimeOffset? to) =>
{
    if (string.IsNullOrWhiteSpace(sensor_id))
    {
        return Results.BadRequest(new ErrorResponse("sensor_id è obbligatorio", "sensor_id"));
    }

    return Results.Ok(CreateReadingsResponse(sensor_id, from, to));
});

app.Run();

static BigInteger HexToBigInteger(string value)
{
    return BigInteger.Parse("0" + value, NumberStyles.AllowHexSpecifier, CultureInfo.InvariantCulture);
}

static ErrorResponse? ValidateTelemetry(Telemetry? telemetry)
{
    if (telemetry is null)
    {
        return new ErrorResponse("La misura è obbligatoria", "body");
    }

    if (!System.Text.RegularExpressions.Regex.IsMatch(telemetry.sensor_id, "^[A-Z]+-[A-Z]{2}-[0-9]{3}$"))
    {
        return new ErrorResponse("Formato sensor_id non valido", "sensor_id");
    }

    if (telemetry.cargo_type is not ("food" or "pharma" or "frozen"))
    {
        return new ErrorResponse("cargo_type deve essere food, pharma oppure frozen", "cargo_type");
    }

    if (telemetry.temperature_c < -40 || telemetry.temperature_c > 40)
    {
        return new ErrorResponse("La temperatura deve essere tra -40 e 40", "temperature_c");
    }

    if (telemetry.humidity is < 0 or > 100 || telemetry.battery is < 0 or > 100)
    {
        return new ErrorResponse("Umidità e batteria devono essere tra 0 e 100", "humidity/battery");
    }

    return null;
}

static ReadingsResponse CreateReadingsResponse(string sensorId, DateTimeOffset? from, DateTimeOffset? to)
{
    var result = readingsForResponse(sensorId, from, to);
    return new ReadingsResponse(result.Count, result);
}

static List<Telemetry> readingsForResponse(string sensorId, DateTimeOffset? from, DateTimeOffset? to)
{
    return readings
        .Where(r => r.sensor_id == sensorId)
        .Where(r => from is null || r.timestamp >= from)
        .Where(r => to is null || r.timestamp <= to)
        .ToList();
}

public record HandshakeRequest(
    [property: JsonPropertyName("p")] string p,
    [property: JsonPropertyName("g")] string g,
    [property: JsonPropertyName("A")] string A);

public record ReadingsRequest(
    string sensor_id,
    DateTimeOffset? from,
    DateTimeOffset? to);

public record Telemetry(
    string sensor_id,
    DateTimeOffset timestamp,
    string cargo_type,
    double temperature_c,
    double? humidity,
    int? battery);

public record ReadingsResponse(int count, List<Telemetry> readings);

public record ErrorResponse(string error, string field);